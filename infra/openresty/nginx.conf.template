worker_processes 1;
error_log logs/error.log info;
pid logs/nginx.pid;

events {
    worker_connections 1024;
}

http {
    lua_package_path "__ROOT_DIR__/infra/openresty/lua/?.lua;;";
    lua_shared_dict token_bucket_store 20m;
    lua_shared_dict token_bucket_locks 1m;

    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    types {
        text/html html htm;
        text/css css;
        application/javascript js mjs;
        application/json json;
        image/png png;
        image/jpeg jpg jpeg;
        image/svg+xml svg;
        image/x-icon ico;
    }

    upstream material_gateway {
        server __GATEWAY_HOST__:__GATEWAY_PORT__;
        keepalive 32;
    }

    server {
        listen __OPENRESTY_PORT__;
        server_name localhost 127.0.0.1;
        client_max_body_size 10m;

        location = /health {
            default_type application/json;
            return 200 '{"status":"UP","service":"openresty"}\n';
        }

        location = /auth/login {
            access_by_lua_block {
                require("token_bucket").limit_ip("entry:auth", __RATE_LIMIT_AUTH_REPLENISH_RATE__, __RATE_LIMIT_AUTH_BURST_CAPACITY__, __RATE_LIMIT_AUTH_REQUESTED_TOKENS__)
            }
            proxy_pass http://material_gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /auth/register {
            access_by_lua_block {
                require("token_bucket").limit_ip("entry:auth", __RATE_LIMIT_AUTH_REPLENISH_RATE__, __RATE_LIMIT_AUTH_BURST_CAPACITY__, __RATE_LIMIT_AUTH_REQUESTED_TOKENS__)
            }
            proxy_pass http://material_gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ~ ^/api/purchase-orders/[^/]+/panic-buy$ {
            access_by_lua_block {
                require("token_bucket").limit_ip("entry:sensitive", __RATE_LIMIT_SENSITIVE_REPLENISH_RATE__, __RATE_LIMIT_SENSITIVE_BURST_CAPACITY__, __RATE_LIMIT_SENSITIVE_REQUESTED_TOKENS__)
            }
            proxy_pass http://material_gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ~ ^/api/transport-orders/[^/]+/claim$ {
            access_by_lua_block {
                require("token_bucket").limit_ip("entry:sensitive", __RATE_LIMIT_SENSITIVE_REPLENISH_RATE__, __RATE_LIMIT_SENSITIVE_BURST_CAPACITY__, __RATE_LIMIT_SENSITIVE_REQUESTED_TOKENS__)
            }
            proxy_pass http://material_gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /auth/ {
            access_by_lua_block {
                require("token_bucket").limit_ip("entry:api", __RATE_LIMIT_API_REPLENISH_RATE__, __RATE_LIMIT_API_BURST_CAPACITY__, __RATE_LIMIT_API_REQUESTED_TOKENS__)
            }
            proxy_pass http://material_gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            access_by_lua_block {
                require("token_bucket").limit_ip("entry:api", __RATE_LIMIT_API_REPLENISH_RATE__, __RATE_LIMIT_API_BURST_CAPACITY__, __RATE_LIMIT_API_REQUESTED_TOKENS__)
            }
            proxy_pass http://material_gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            root "__ROOT_DIR__/web-frontend";
            try_files $uri $uri/ /index.html;
        }
    }
}
